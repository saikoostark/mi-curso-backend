# Copy to .env and fill in real values. `.env` is gitignored (see AGENTS.md -> Security).

# Postgres connection used by the application. Point it at any database you want —
# nothing creates databases for you; `npm run db:migration:run` only applies migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/micurso_dev

# Dedicated database for e2e tests — create it yourself (nothing auto-creates it).
# Tests truncate the data they touch, so it must NOT be the same DB as DATABASE_URL.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/micurso_test

# HTTP port for the Nest application.
PORT=3000
